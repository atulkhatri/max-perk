rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user reads/writes only their own wallet + preferences.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      match /wallet/{cardId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    // Curated catalog is bundled with the app in v1; this path reserves a
    // future server-hosted catalog (public read, no client writes).
    match /catalog/{doc=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
