{
  "name": "card-offers",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "emulators": "firebase emulators:start --only auth,firestore",
    "seed:emulators": "node scripts/seed-emulators.mjs",
    "catalog:fetch": "node scripts/fetch-issuer-pages.mjs",
    "catalog:diff": "node scripts/fetch-issuer-pages.mjs --diff",
    "catalog:sync:dry": "node scripts/sync-catalog-to-firestore.mjs --dry-run",
    "catalog:sync:emulator": "node scripts/sync-catalog-to-firestore.mjs --emulator --prune",
    "catalog:sync": "node scripts/sync-catalog-to-firestore.mjs",
    "deploy": "npm run build && firebase deploy --only hosting,firestore:rules"
  },
  "dependencies": {
    "firebase": "^13.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.5",
    "vitest": "^4.0.0"
  }
}
