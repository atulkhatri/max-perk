{
  "name": "card-offers",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "node scripts/verify-firestore-rules.mjs",
    "typecheck": "tsc -b",
    "emulators": "firebase emulators:start --only auth,firestore",
    "seed:emulators": "node scripts/seed-emulators.mjs",
    "seed:catalog": "node scripts/seed-catalog-emulator.mjs",
    "catalog:fetch": "node scripts/fetch-issuer-pages.mjs",
    "catalog:diff": "node scripts/fetch-issuer-pages.mjs --diff",
    "catalog:sync:dry": "node scripts/sync-catalog-to-firestore.mjs --dry-run",
    "catalog:sync:emulator": "node scripts/sync-catalog-to-firestore.mjs --emulator --prune",
    "catalog:sync": "node scripts/sync-catalog-to-firestore.mjs",
    "deploy": "npm run build && firebase deploy --only hosting,firestore:rules"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^13.1.0",
    "lucide-react": "^1.66.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.5",
    "vitest": "^4.0.0"
  }
}
