# Copy to .env.development / .env.production and fill in. Values are bundled
# into the client on purpose: Firebase web keys are public by design and the
# real access control lives in firestore.rules. Never put admin SDK
# credentials in any VITE_ variable.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# Server-side scripts only (no VITE_ prefix on purpose: these must never
# reach the client bundle). The catalog sync authenticates with a Firebase
# service-account key (Datastore User role) stored OUTSIDE the repo.
GOOGLE_APPLICATION_CREDENTIALS=
# Optional override when the key's project differs from the target.
FIRESTORE_PROJECT_ID=
# Catalog sync via Firebase CLI login (scripts/lib/firebase-login.mjs): same
# OAuth client the Firebase CLI itself uses. Never commit a value here.
FIREBASE_CLIENT_SECRET=
# Ask-pick (free-text card check) calls Muse Spark 1.3 server-side from
# the askPick Cloud Function. The key is a Firebase secret, NOT a client
# env var: `firebase functions:secrets:set MODEL_API_KEY`. For local
# emulators, put MODEL_API_KEY=... in functions/.secret.local (gitignored).
MODEL_API_KEY=

# Local development against Firebase emulators (see firebase.json).
VITE_USE_EMULATORS=false
VITE_AUTH_EMULATOR_HOST=http://127.0.0.1:9099
VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1
VITE_FIRESTORE_EMULATOR_PORT=8080
